<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Hardened Runtime a notarized build runs under. Kotone drives the Spotify app over
     AppleScript, which the runtime blocks unless it's declared here (the user still approves it
     once, with NSAppleEventsUsageDescription). WKWebView's JIT runs in WebKit's own processes. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
